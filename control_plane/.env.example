# ZIMAM control-plane configuration.
# These values are safe local defaults. Replace every secret before exposing
# the control plane outside a trusted development machine.
ZIMAM_DATABASE_URL=postgresql+psycopg://zimam:zimam_local_dev_password@postgres:5432/zimam
ZIMAM_BOOTSTRAP_TOKEN=local-bootstrap-token-change-me
ZIMAM_GATEWAY_TOKEN=local-gateway-token-change-me
ZIMAM_AGENT_ENROLLMENT_TOKEN=local-enrollment-token-change-me
ZIMAM_VAULT_KEY=
ZIMAM_SECURE_COOKIES=0
ZIMAM_ALLOWED_ORIGINS=http://localhost:8876,http://127.0.0.1:8876
