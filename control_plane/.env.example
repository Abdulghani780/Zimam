# ASAAS control-plane configuration.
# These values are safe local defaults. Replace every secret before exposing
# the control plane outside a trusted development machine.
ASAAS_DATABASE_URL=postgresql+psycopg://asaas:asaas_local_dev_password@postgres:5432/asaas
ASAAS_BOOTSTRAP_TOKEN=local-bootstrap-token-change-me
ASAAS_GATEWAY_TOKEN=local-gateway-token-change-me
ASAAS_AGENT_ENROLLMENT_TOKEN=local-enrollment-token-change-me
ASAAS_VAULT_KEY=
ASAAS_SECURE_COOKIES=0
ASAAS_ALLOWED_ORIGINS=http://localhost:8876,http://127.0.0.1:8876

# Guacamole session gateway. Empty disables live RDP/SSH/VNC sessions honestly.
ASAAS_GUACD_HOST=
ASAAS_GUACD_PORT=4822
ASAAS_GUACD_TIMEOUT=10
ASAAS_GW_RECORD=1
ASAAS_RECORDINGS_DIR=data/recordings

# Optional single-worker token replay protection; required for multi-worker deployments.
ASAAS_REDIS_URL=

# Optional off-box backup replication (file/UNC, SFTP, or S3 destination).
ASAAS_BACKUP_DEST=
ASAAS_BACKUP_SFTP_PASSWORD=
ASAAS_BACKUP_SFTP_KEY_PATH=
# S3 uses the standard boto3 AWS credential/environment configuration.
