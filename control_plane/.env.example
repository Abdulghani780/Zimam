# ASAAS control-plane configuration.
# These values are safe local defaults. Replace every secret before exposing
# the control plane outside a trusted development machine.
ASAAS_DATABASE_URL=postgresql+psycopg://asaas:asaas_local_dev_password@postgres:5432/asaas
ASAAS_BOOTSTRAP_TOKEN=local-bootstrap-token-change-me
ASAAS_GATEWAY_TOKEN=local-gateway-token-change-me
ASAAS_AGENT_ENROLLMENT_TOKEN=local-enrollment-token-change-me
ASAAS_VAULT_KEY=
ASAAS_SECURE_COOKIES=0
ASAAS_ALLOWED_ORIGINS=http://localhost:8876,http://127.0.0.1:8876
