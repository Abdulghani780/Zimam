# ASAAS Server Control - control plane environment file.
# Copy to control-plane.env next to asaas-control.exe (or repo root in dev).
# Real environment variables always take precedence over this file.

# Network
# ASAAS_HOST=127.0.0.1
# ASAAS_CP_PORT=8876
# ASAAS_LEGACY_API_URL=http://127.0.0.1:8765

# TLS (both or neither) - generate with: python tools/gen-server-cert.py
# ASAAS_TLS_CERT=C:\ProgramData\ASAAS\tls\cert.pem
# ASAAS_TLS_KEY=C:\ProgramData\ASAAS\tls\key.pem

# Session gateway (guacd) - leave unset to disable; WS endpoint then closes 1013
# ASAAS_GUACD_HOST=127.0.0.1
# ASAAS_GUACD_PORT=4822
# ASAAS_GUACD_TIMEOUT=10
# ASAAS_GW_WIDTH=1920
# ASAAS_GW_HEIGHT=1080
# ASAAS_GW_DPI=96

# Scheduled backups (hours between runs, 0 disables; keep N newest)
# ASAAS_BACKUP_INTERVAL_HOURS=24
# ASAAS_BACKUP_KEEP=14

# License / keys (defaults resolve under the install data dir)
# ASAAS_LICENSE_FILE=
# ASAAS_JOB_SIGNING_KEY_FILE=
