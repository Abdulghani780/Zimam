# ZIMAM - control plane environment file.
# Copy to control-plane.env next to zimam-control.exe (or repo root in dev).
# Real environment variables always take precedence over this file.

# Network
# ZIMAM_HOST=127.0.0.1
# ZIMAM_CP_PORT=8876
# ZIMAM_LEGACY_API_URL=http://127.0.0.1:8765

# TLS (both or neither) - generate with: python tools/gen-server-cert.py
# ZIMAM_TLS_CERT=C:\ProgramData\ZIMAM\tls\cert.pem
# ZIMAM_TLS_KEY=C:\ProgramData\ZIMAM\tls\key.pem

# Session gateway (guacd) - leave unset to disable; WS endpoint then closes 1013
# ZIMAM_GUACD_HOST=127.0.0.1
# ZIMAM_GUACD_PORT=4822
# ZIMAM_GUACD_TIMEOUT=10
# ZIMAM_GW_WIDTH=1920
# ZIMAM_GW_HEIGHT=1080
# ZIMAM_GW_DPI=96

# Scheduled backups (hours between runs, 0 disables; keep N newest)
# ZIMAM_BACKUP_INTERVAL_HOURS=24
# ZIMAM_BACKUP_KEEP=14

# License / keys (defaults resolve under the install data dir)
# ZIMAM_LICENSE_FILE=
# ZIMAM_JOB_SIGNING_KEY_FILE=
